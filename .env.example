# ==========================================================================
# 3DS HOME PLATFORM — muhit o'zgaruvchilari namunasi
# --------------------------------------------------------------------------
# Nusxa oling:  cp .env.example .env
#
# ⚠️ TZ SEC-07: .env HECH QACHON repozitoriyaga tushmaydi (.gitignore da).
#    Bu yerda faqat lokal ishlab chiqish uchun xavfsiz qiymatlar turadi.
# ==========================================================================

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=3ds
POSTGRES_PASSWORD=3ds_local_dev
POSTGRES_DB=3ds_home
POSTGRES_PORT=5432

DATABASE_URL="postgresql://3ds:3ds_local_dev@localhost:5432/3ds_home?schema=public"

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- MinIO (S3-mos) --------------------------------------------------------
MINIO_ROOT_USER=3ds_minio
MINIO_ROOT_PASSWORD=3ds_minio_local_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT="http://localhost:9000"
S3_BUCKET_IMAGES=3ds-images
S3_BUCKET_PANORAMAS=3ds-panoramas

# --- API -------------------------------------------------------------------
API_PORT=3001
NODE_ENV=development

# --- Auth ------------------------------------------------------------------
# ⚠️ Productionda kuchli tasodifiy qiymat bilan almashtiriladi
JWT_ACCESS_SECRET=change_me_in_production_access
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- SMS (TZ ochiq savol №7 — provayder hali tanlanmagan) -----------------
# SMS_PROVIDER=eskiz
# SMS_API_KEY=
# SMS_FROM=

# --- AI qatlami (TZ §16) ---------------------------------------------------
# ANTHROPIC_API_KEY=
AI_MODEL_MODERATION=claude-haiku-4-5
AI_MODEL_MODERATION_ESCALATION=claude-opus-5
AI_MODEL_DESCRIPTION=claude-sonnet-5

# --- Tashqi xizmatlar ------------------------------------------------------
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
CBU_RATES_URL="https://cbu.uz/uz/arkhiv-kursov-valyut/json/"

# --- Biznes qoidalari (TZ dan) ---------------------------------------------
POI_RADIUS_METERS=2000
POI_MAX_PER_TYPE=3
POI_MAX_TOTAL=12
WALK_SPEED_METERS_PER_MINUTE=80
